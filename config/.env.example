# Copy to config/.env  →  chmod 600 config/.env  →  never commit.
# All services below are used on their FREE tiers only.

# OpenRouter — https://openrouter.ai/keys   (free account; use only :free model ids)
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=animal-story-automation
OPENROUTER_SITE_URL=

# Hugging Face — https://huggingface.co/settings/tokens  (read token is enough)
HF_TOKEN=

# Replicate — https://replicate.com/account/api-tokens
# NOT a free tier. This is the only route to real lip-sync: the local 2.5D renderer moves a
# jaw but cannot shape a mouth, because it places the face from the framing word in the
# prompt and the image model does not reliably obey it. Billed per second of output, so
# providers.video.replicate.speaking_only spends it only on shots with a mouth on screen.
# Leave blank and the pipeline falls back to the local renderer with no error.
REPLICATE_API_TOKEN=

# fal.ai — https://fal.ai/dashboard/keys
# Free credits on signup, no card. Hosts the SAME models as Replicate (OmniHuman, Wan-S2V)
# on a separate allowance, which is the point: platform choice does not change the price -
# the cost is GPU time, ~$0.14/s for OmniHuman anywhere - so what this key buys is another
# free allowance and a second chance when one service is down. Leave blank and the chain
# skips it silently.
FAL_KEY=

# WaveSpeedAI — https://wavespeed.ai/dashboard/api-keys
# Free credits on signup, no card. The one worth keeping after the free credit is gone: it
# serves the open-weights Wan-2.2-S2V at roughly $0.06/s at 720p and $0.03/s at 480p against
# ~$0.14/s for OmniHuman, because open weights let hosts compete on the same model. Bills a
# 3-second minimum per clip. Leave blank and the chain skips it silently.
WAVESPEED_API_KEY=

# Alibaba Model Studio (DashScope) — https://bailian.console.alibabacloud.com
# INTERNATIONAL console, not the mainland one: separate regions with separate accounts, and
# a mainland key is answered 401 here, which reads like a typo. This is Wan FIRST PARTY -
# the same open-weights Wan-2.2 that Replicate, fal and WaveSpeed resell - so what this key
# buys is a fresh signup allowance for the model already known to render real gesture, at
# the lowest per-second price of the four once that allowance is spent.
DASHSCOPE_API_KEY=

# Novita — https://novita.ai/settings/key-management
# Free credit on signup ($1, no card). The one service in the chain running a Wan NEWER
# than 2.2 (`wan2.7-i2v`), which is a bigger quality difference than anything configurable.
# Its i2v route documents an `audio_url` input, so it may cover speaking shots as well -
# unproven here, and it fails silently if wrong (a fluent performance of the wrong words),
# so watch one shot before trusting a run to it.
NOVITA_API_KEY=

# SiliconFlow — https://cloud.siliconflow.com/account/ak
# Wan on another account again. NO audio-driven model, so it renders the non-speaking shots
# only, and it is priced per VIDEO (~$0.29) rather than per second with no documented free
# grant - which is why providers.video.siliconflow.max_shots is 5 rather than 40.
SILICONFLOW_API_KEY=

# Freesound — https://freesound.org/apiv2/apply
FREESOUND_API_KEY=

# YouTube Data API v3 + YouTube Analytics API (Desktop-app OAuth client)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_TOKEN_PATH=data/secrets/yt_token.json

# Plain API key for the SAME Cloud project, used only by the youtube_search research
# collector - search.list reads public data and needs no user consent, so it cannot use the
# OAuth token above. Optional: without it that collector is skipped and research runs with
# no YouTube demand signal. It spends the project's shared 10,000 units/day at 100 units a
# call, which is why research.youtube_search_calls_per_day is capped at 4.
# Restrict the key to YouTube Data API v3 in the Cloud console.
YT_API_KEY=

# Optional research source - requires manual Reddit app approval (2-4 week queue).
# Leave blank and keep `reddit` out of research.collectors until approved.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=animal-story-automation/0.1 by u/yourname

# NOT NEEDED: Pixabay's API has no music/audio endpoint (images and videos only).
# Download Pixabay music manually into assets/music/ instead.

# ---- Optional LLM buffer providers -------------------------------------------
# All are real no-card free tiers. Any left blank is skipped; the buffer degrades
# rather than breaking. More keys = more headroom when free pools are busy.

# Groq - https://console.groq.com/keys   (30 RPM / 6,000 TPM / 14,400 req-day)
GROQ_API_KEY=

# Google AI Studio - https://aistudio.google.com/apikey  (limits vary by model; verify yours)
# Mistral La Plateforme (free "Experiment" tier) and Cohere's OpenAI
# compatibility layer. Both free, no card. Every extra key is one more provider
# the chain can fall through to when a free pool returns 429.
MISTRAL_API_KEY=
COHERE_API_KEY=

# Google. Read by TWO parts of the pipeline now: the story LLM fallback above, and Veo for
# video (providers.video.google) - the same key, the same project's quota. NOT Google Flow,
# which is the subscription web app on this model and has no API. Veo is excluded from the
# Gemini free tier, so a key that is fine for text will be refused for video until billing
# is enabled on the project; `asa video preflight` says so plainly.
GEMINI_API_KEY=

# Cloudflare Workers AI - https://dash.cloudflare.com/profile/api-tokens (10,000 Neurons/day)
# Also set providers.llm.cloudflare_free.base_url with your account id in config.yaml
CLOUDFLARE_API_TOKEN=

# Sarvam AI text-to-speech (Indian-language voices, far more natural in Hindi
# than the local Kokoro model). Get a key at https://dashboard.sarvam.ai
# Without it the chain falls back to Kokoro and still renders.
SARVAM_API_KEY=

# Experiential Labs — https://platform.experientiallabs.ai
# TEXT inference only, OpenAI- and Anthropic-compatible, sitting FIRST in
# providers.llm.chain. It is the one non-free entry there: the eight free tiers below it
# are small models that a measured story run spent ~13 minutes walking, and one frontier
# model with a 1M context should do that in a single call.
# NOT a video or image provider whatever the model catalogue suggests - /v1/videos and
# /v1/images/generations both answer "Unsupported serving path", and none of its 500
# models is a video model, so it cannot serve providers.video.
# REQUIRES A CARD before it will serve anything: without one every completion returns
# 429 card_required and the chain simply falls through to groq_free. Adding the card is
# free (platform.experientiallabs.ai/credits?add-card=1).
EXPLABS_API_KEY=
